+/*
+ * Wake word detection with a microWakeWord v2 model (github.com/kahrendt/microWakeWord,
+ * models from github.com/esphome/micro-wake-word-models, both Apache-2.0).
+ *
+ * Features follow pymicro-features (the reference microWakeWord trains with):
+ * 30 ms windows every 10 ms, 40 channels over 125-7500 Hz, noise reduction,
+ * PCAN gain control and log scale, scaled by 0.0390625 and quantized with the
+ * model's input scale. The model is streaming: it takes 3 feature rows per
+ * call and keeps its state in resource variables. A detection is a sliding
+ * window average of its output over CONFIG_MUSE_WAKE_WINDOW calls reaching
+ * CONFIG_MUSE_WAKE_CUTOFF (out of 255).
+ */
+#include "muse_wake.h"
+
+#include <cmath>
+#include <cstring>
+#include <new>
+
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "sdkconfig.h"
+
+#if CONFIG_MUSE_WAKE_WORD
+
+#include "tensorflow/lite/experimental/microfrontend/lib/frontend.h"
+#include "tensorflow/lite/experimental/microfrontend/lib/frontend_util.h"
+#include "tensorflow/lite/micro/micro_allocator.h"
+#include "tensorflow/lite/micro/micro_interpreter.h"
+#include "tensorflow/lite/micro/micro_mutable_op_resolver.h"
+#include "tensorflow/lite/micro/micro_resource_variable.h"
+#include "tensorflow/lite/schema/schema_generated.h"
+
+static const char *TAG = "muse_wake";
+
+extern const uint8_t s_model[] asm("_binary_wake_word_tflite_start");
+
+namespace {
+
+constexpr int kRate = 16000;
+constexpr int kStep = kRate / 100;          /* 10 ms of samples per feature row */
+constexpr int kChannels = 40;
+constexpr int kStride = 3;                  /* feature rows per model call */
+constexpr size_t kArenaBytes = 18 * 1024;   /* "Hey Jarvis" uses 15.9 KB */
+constexpr float kFeatureScale = 0.0390625f;
+constexpr int kWindow = CONFIG_MUSE_WAKE_WINDOW;
+
+FrontendState s_frontend;
+tflite::MicroInterpreter *s_interp;
+TfLiteTensor *s_input;
+float s_in_scale;
+int s_in_zero;
+bool s_ready;
+
+int16_t s_pending[kStep];
+size_t s_npending;
+int8_t s_rows[kStride][kChannels];
+int s_nrows;
+uint8_t s_probs[kWindow];
+int s_nprobs, s_iprob;
+int s_warmup;                               /* model calls ignored after a reset */
+constexpr int kWarmupCalls = 20;            /* 600 ms: the model's context refills */
+
+/* Inference cost, logged now and then: classic ESP32s have no vector unit. */
+int64_t s_busy_us, s_stat_since;
+int s_calls;
+uint8_t s_peak;
+
+bool init_frontend(void)
+{
+    FrontendConfig cfg;
+    FrontendFillConfigWithDefaults(&cfg);
+    cfg.window.size_ms = 30;
+    cfg.window.step_size_ms = 10;
+    cfg.filterbank.num_channels = kChannels;
+    cfg.filterbank.lower_band_limit = 125.0f;
+    cfg.filterbank.upper_band_limit = 7500.0f;
+    cfg.noise_reduction.smoothing_bits = 10;
+    cfg.noise_reduction.even_smoothing = 0.025f;
+    cfg.noise_reduction.odd_smoothing = 0.06f;
+    cfg.noise_reduction.min_signal_remaining = 0.05f;
+    cfg.pcan_gain_control.enable_pcan = 1;
+    cfg.pcan_gain_control.strength = 0.95f;
+    cfg.pcan_gain_control.offset = 80.0f;
+    cfg.pcan_gain_control.gain_bits = 21;
+    cfg.log_scale.enable_log = 1;
+    cfg.log_scale.scale_shift = 6;
+    return FrontendPopulateState(&cfg, &s_frontend, kRate) == 1;
+}
+
+bool infer(uint8_t *prob)
+{
+    for (int r = 0; r < kStride; r++) {
+        memcpy(s_input->data.int8 + r * kChannels, s_rows[r], kChannels);
+    }
+    int64_t t0 = esp_timer_get_time();
+    if (s_interp->Invoke() != kTfLiteOk) {
+        return false;
+    }
+    s_busy_us += esp_timer_get_time() - t0;
+    s_calls++;
+    *prob = s_interp->output(0)->data.uint8[0];
+    return true;
+}
+
+void log_stats(void)
+{
+    int64_t now = esp_timer_get_time();
+    if (now - s_stat_since < 60 * 1000000LL || !s_calls) {
+        return;
+    }
+    ESP_LOGI(TAG, "%d calls, %.1f ms each, %.1f%% CPU; peak score %u", s_calls,
+             s_busy_us / 1000.0 / s_calls, 100.0 * s_busy_us / (now - s_stat_since), s_peak);
+    s_stat_since = now;
+    s_busy_us = 0;
+    s_calls = 0;
+    s_peak = 0;
+}
+
+}  // namespace
+
+bool muse_wake_init(void)
+{
+    if (s_ready) {
+        return true;
+    }
+    const tflite::Model *model = tflite::GetModel(s_model);
+    if (model->version() != TFLITE_SCHEMA_VERSION) {
+        ESP_LOGE(TAG, "model schema %lu, expected %d", (unsigned long)model->version(), TFLITE_SCHEMA_VERSION);
+        return false;
+    }
+    /* PSRAM: internal RAM must stay free for the I2S DMA buffers, which the
+     * Core2 reallocates each time it switches between mic and speaker. */
+    uint8_t *arena = static_cast<uint8_t *>(heap_caps_aligned_alloc(16, kArenaBytes, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (!arena || !init_frontend()) {
+        ESP_LOGE(TAG, "out of memory");
+        return false;
+    }
+    static tflite::MicroMutableOpResolver<12> ops;
+    ops.AddCallOnce();
+    ops.AddVarHandle();
+    ops.AddReadVariable();
+    ops.AddAssignVariable();
+    ops.AddConcatenation();
+    ops.AddConv2D();
+    ops.AddDepthwiseConv2D();
+    ops.AddFullyConnected();
+    ops.AddLogistic();
+    ops.AddQuantize();
+    ops.AddReshape();
+    ops.AddStridedSlice();
+    tflite::MicroAllocator *alloc = tflite::MicroAllocator::Create(arena, kArenaBytes);
+    tflite::MicroResourceVariables *vars = alloc ? tflite::MicroResourceVariables::Create(alloc, 20) : nullptr;
+    s_interp = vars ? new (std::nothrow) tflite::MicroInterpreter(model, ops, alloc, vars) : nullptr;
+    if (!s_interp || s_interp->AllocateTensors() != kTfLiteOk) {
+        ESP_LOGE(TAG, "model doesn't fit its %u byte arena", (unsigned)kArenaBytes);
+        return false;
+    }
+    s_input = s_interp->input(0);
+    if (s_input->type != kTfLiteInt8 || s_input->dims->size != 3 || s_input->dims->data[1] != kStride ||
+        s_input->dims->data[2] != kChannels || s_interp->output(0)->type != kTfLiteUInt8) {
+        ESP_LOGE(TAG, "unexpected model input/output");
+        return false;
+    }
+    s_in_scale = s_input->params.scale;
+    s_in_zero = s_input->params.zero_point;
+    s_stat_since = esp_timer_get_time();
+    s_ready = true;
+    ESP_LOGI(TAG, "\"%s\" ready: arena %u of %u bytes, cutoff %d/255 over %d", CONFIG_MUSE_WAKE_WORD_NAME,
+             (unsigned)s_interp->arena_used_bytes(), (unsigned)kArenaBytes, CONFIG_MUSE_WAKE_CUTOFF, kWindow);
+    return true;
+}
+
+bool muse_wake_feed(const int16_t *pcm, size_t samples)
+{
+    if (!s_ready) {
+        return false;
+    }
+    bool heard = false;
+    while (samples) {
+        size_t take = kStep - s_npending < samples ? kStep - s_npending : samples;
+        memcpy(s_pending + s_npending, pcm, take * sizeof(int16_t));
+        s_npending += take;
+        pcm += take;
+        samples -= take;
+        if (s_npending < kStep) {
+            break;
+        }
+        size_t read = 0;
+        FrontendOutput out = FrontendProcessSamples(&s_frontend, s_pending, kStep, &read);
+        s_npending = 0;
+        if (out.size != kChannels) {
+            continue;
+        }
+        for (int c = 0; c < kChannels; c++) {
+            int q = (int)lroundf(out.values[c] * kFeatureScale / s_in_scale) + s_in_zero;
+            s_rows[s_nrows][c] = (int8_t)(q < -128 ? -128 : q > 127 ? 127 : q);
+        }
+        if (++s_nrows < kStride) {
+            continue;
+        }
+        s_nrows = 0;
+        uint8_t prob;
+        if (!infer(&prob)) {
+            continue;
+        }
+        if (s_warmup > 0) {
+            s_warmup--;
+            continue;
+        }
+        s_peak = prob > s_peak ? prob : s_peak;
+        s_probs[s_iprob] = prob;
+        s_iprob = (s_iprob + 1) % kWindow;
+        s_nprobs = s_nprobs < kWindow ? s_nprobs + 1 : kWindow;
+        if (s_nprobs == kWindow) {
+            int sum = 0;
+            for (int i = 0; i < kWindow; i++) {
+                sum += s_probs[i];
+            }
+            if (sum >= CONFIG_MUSE_WAKE_CUTOFF * kWindow) {
+                ESP_LOGI(TAG, "heard \"%s\" (average %d/255)", CONFIG_MUSE_WAKE_WORD_NAME, sum / kWindow);
+                heard = true;
+                memset(s_probs, 0, sizeof(s_probs));
+                s_nprobs = 0;
+            }
+        }
+    }
+    log_stats();
+    return heard;
+}
+
+void muse_wake_reset(void)
+{
+    if (!s_ready) {
+        return;
+    }
+    /* The model is streaming: its resource variables hold the last second or
+     * so of features. Without clearing them, audio from before a turn (the
+     * wake word itself) fires it again as soon as listening resumes. */
+    s_interp->Reset();
+    FrontendReset(&s_frontend);
+    memset(s_probs, 0, sizeof(s_probs));
+    s_nprobs = s_iprob = 0;
+    s_nrows = 0;
+    s_npending = 0;
+    s_warmup = kWarmupCalls;
+}
+
+#endif /* CONFIG_MUSE_WAKE_WORD */
