# Copy to .env (git-ignored) and fill in. Never commit .env.

# Meta Model API key (https://dev.meta.ai -> API keys). Used by pc/agent.py.
MODEL_API_KEY=

# Muse Gadget SDK token (https://gadgets.muse.ai -> Account -> SDK tokens),
# starts with mgst_. Used by muse-gadget/build.sh.
GADGET_SDK_TOKEN=

# The speech server (pc/speech_server.py, or cloud/Dockerfile on a host):
# the Core2 speaks Muse's replies with /tts and transcribes you with /stt.
# On your LAN: http://<pc>:8766/... ; on the internet: https:// plus a token.
TTS_URL=http://192.168.1.10:8766/tts
STT_URL=http://192.168.1.10:8766/stt
# Required when the server is reachable from the internet (same value as the
# server's SPEECH_TOKEN). Generate one with: openssl rand -base64 32
SPEECH_TOKEN=

# Optional fallback for glasses frames: the PC running pc/viewer.py. The Core2
# first looks for the Glasses Bridge iPhone app on Wi-Fi (mDNS); leave this
# empty to use the phone only.
GLASSES_RELAY_URL=http://192.168.1.10:8765/snapshot.jpg

# Optional: where meal photos and meals.jsonl are saved (default ./meal-log).
# MEAL_LOG_DIR=
