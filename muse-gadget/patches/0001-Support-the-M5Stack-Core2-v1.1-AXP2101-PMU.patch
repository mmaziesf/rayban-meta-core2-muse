 {
-    /* Power the amp: AXP192 GPIO2, through the BSP's rail setup. I2S channels
+    /* Power the amp (AXP192 GPIO2 on v1.0, AXP2101 ALDO3 on v1.1) through the BSP's rail setup. I2S channels
      * are created lazily by use_mic()/use_speaker(), one direction at a time. */
     ESP_RETURN_ON_ERROR(bsp_feature_enable(BSP_FEATURE_SPEAKER, true), TAG, "speaker rail");
 
@@ -421,7 +449,7 @@ static esp_err_t audio_init(esp_codec_dev_handle_t *spk, esp_codec_dev_handle_t
     return *spk && *mic ? ESP_OK : ESP_FAIL;
 }
 
-/* BtnB reports real held edges. The AXP192 reports completed short/long
+/* BtnB reports real held edges. The PMU reports completed short/long
  * presses instead: a short press is an aux click, and a long press requests
  * shutdown directly, before the PMU's ~4 s hardware cut. */
 static unsigned poll_buttons(void)
@@ -448,6 +476,34 @@ static unsigned poll_buttons(void)
     return out;
 }
 
+/* The Watcher's LiPo curve, as on the other M5Stack boards. */
+static int battery_pct_from_mv(int v)
+{
+    int pct = (-v * v + 9016 * v - 19189000) / 10000;
+    return pct < 0 ? 0 : pct > 100 ? 100 : pct;
+}
+
+#if CONFIG_BSP_PMU_AXP2101
+/* Battery voltage (14-bit ADC, 1 mV steps, regs 0x34-0x35), charger and USB state. */
+static esp_err_t read_power(muse_power_t *out)
+{
+    uint8_t r00, r01, batt[2];
+    ESP_RETURN_ON_ERROR(axp_read(0x00, &r00, 1), TAG, "axp status");
+    ESP_RETURN_ON_ERROR(axp_read(0x01, &r01, 1), TAG, "axp charge status");
+    ESP_RETURN_ON_ERROR(axp_read(0x34, batt, sizeof(batt)), TAG, "axp battery");
+    out->usb = (r00 & 0x20) != 0;                    /* VBUS good */
+    out->charging = ((r01 >> 5) & 0x03) == 0x01;     /* 01 charge, 10 discharge, 00 standby */
+    if ((r00 & 0x08) == 0) {                         /* no battery */
+        out->battery_mv = 0;
+        out->battery_pct = -1;
+        return ESP_OK;
+    }
+    int v = ((batt[0] & 0x3f) << 8) | batt[1];
+    out->battery_mv = v;
+    out->battery_pct = v < 2500 ? -1 : battery_pct_from_mv(v);
+    return ESP_OK;
+}
+#else
 /* Battery voltage (12-bit ADC, 1.1 mV steps), charger and USB state. */
 static esp_err_t read_power(muse_power_t *out)
 {
@@ -468,25 +524,33 @@ static esp_err_t read_power(muse_power_t *out)
         out->battery_pct = -1;
         return ESP_OK;
     }
-    /* The Watcher's LiPo curve, as on the other M5Stack boards. */
-    int pct = (-v * v + 9016 * v - 19189000) / 10000;
-    out->battery_pct = pct < 0 ? 0 : pct > 100 ? 100 : pct;
+    out->battery_pct = battery_pct_from_mv(v);
     return ESP_OK;
 }
+#endif
 
 /*
- * Screen dark, then the AXP192 cuts every rail; PWR turns the board back on.
+ * Screen dark, then the PMU cuts every rail; PWR turns the board back on.
  * The PEK event register has no physical held state to wait on.
  */
 static esp_err_t power_off(void)
 {
     set_brightness(0);
+#if CONFIG_BSP_PMU_AXP2101
+    /* PMU common config, bit 0: power off (M5Unified's AXP2101 powerOff). */
+    ESP_RETURN_ON_ERROR(axp_write_masked(0x10, 0x01, 0x01), TAG, "axp shutdown");
+#else
     ESP_RETURN_ON_ERROR(axp_write_masked(0x32, 0x80, 0x80), TAG, "axp shutdown");
+#endif
     return ESP_FAIL;
 }
 
 static const muse_board_t s_board = {
+#if CONFIG_BSP_PMU_AXP2101
+    .name = "M5Stack Core2 v1.1",
+#else
     .name = "M5Stack Core2",
+#endif
     .width = BSP_LCD_H_RES,
     .height = BSP_LCD_V_RES,
     .round = false,
