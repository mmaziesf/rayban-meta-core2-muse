diff --git a/esp32/devices/sdkconfig.muse-m5stack-core2-v11 b/esp32/devices/sdkconfig.muse-m5stack-core2-v11
index 0e0c02a..5a141ab 100644
--- a/esp32/devices/sdkconfig.muse-m5stack-core2-v11
+++ b/esp32/devices/sdkconfig.muse-m5stack-core2-v11
@@ -54,3 +54,22 @@ CONFIG_BSP_PMU_AXP2101=y
 # glasses-bridge relay on the home network (~/Documents/core2_projects/glasses-bridge).
 # Set CONFIG_HOMEHUB_GLASSES_CAPTURE_URL per device, like the SDK token.
 CONFIG_HOMEHUB_GLASSES_CAPTURE=y
+# Frames straight from the Glasses Bridge iPhone app (mDNS); the URL is the fallback.
+CONFIG_HOMEHUB_GLASSES_DISCOVER=y
+
+# Spoken replies from a text-to-speech server on the home network
+# (glasses-bridge/pc/speech_server.py). Set CONFIG_MUSE_TTS_URL per device.
+CONFIG_MUSE_TTS=y
+# Transcribe presses on the same server (/stt) and send Muse text: faster
+# than a voice note. Set CONFIG_MUSE_STT_URL per device.
+CONFIG_MUSE_LOCAL_STT=y
+# Tap to talk (ends when you stop speaking). Follow-ups off for now: every
+# turn starts with the wake word (set MUSE_FOLLOW_UP_S to listen after replies).
+CONFIG_MUSE_HANDS_FREE=y
+CONFIG_MUSE_FOLLOW_UP_S=0
+# On-device wake word ("Hey Jarvis", microWakeWord on TensorFlow Lite Micro).
+CONFIG_MUSE_WAKE_WORD=y
+CONFIG_MUSE_VOICE_NOTE_HINT="Voice chat from my desk gadget: reply warmly and naturally in one to three short spoken sentences, with no lists, markdown, emoji or links, since it will be read aloud."
+
+# Resume TLS sessions to the speech server when a kept connection has closed.
+CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
-- 
