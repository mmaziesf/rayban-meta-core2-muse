# Copy to .env (git-ignored) and fill in. Never commit .env.

# Meta Model API key (https://dev.meta.ai -> API keys). Used by pc/agent.py.
MODEL_API_KEY=

# Muse Gadget SDK token (https://gadgets.muse.ai -> Account -> SDK tokens),
# starts with mgst_. Used by muse-gadget/build.sh.
GADGET_SDK_TOKEN=

# Where the Muse gadget fetches glasses frames: the PC running pc/viewer.py.
GLASSES_RELAY_URL=http://192.168.1.10:8765/snapshot.jpg

# Optional: where meal photos and meals.jsonl are saved (default ./meal-log).
# MEAL_LOG_DIR=
