+esp_http_client_handle_t muse_speech_client(const char *url, int timeout_ms, http_event_handle_cb handler)
+{
+    esp_http_client_config_t cfg = {
+        .url = url,
+        .timeout_ms = timeout_ms,
+        .buffer_size = 2048,
+        .event_handler = handler,
+        .crt_bundle_attach = esp_crt_bundle_attach,
+        .keep_alive_enable = true,   /* TCP keep-alive probes notice a dead link */
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+        /* A new TLS connection resumes the last session (plain HTTP has none to save). */
+        .save_client_session = strncmp(url, "https://", 8) == 0,
+#endif
+    };
+    esp_http_client_handle_t client = esp_http_client_init(&cfg);
+    if (client && CONFIG_MUSE_SPEECH_TOKEN[0]) {
+        esp_http_client_set_header(client, "Authorization", "Bearer " CONFIG_MUSE_SPEECH_TOKEN);
+    }
+    return client;
+}
+
+bool muse_speech_stale(esp_err_t err)
+{
+    if (err == ESP_ERR_HTTP_CONNECTION_CLOSED || err == ESP_ERR_HTTP_FETCH_HEADER || err == ESP_ERR_HTTP_WRITE_DATA) {
+        ESP_LOGI(TAG, "kept connection gone (%s): retrying on a new one", esp_err_to_name(err));
+        return true;
+    }
+    return false;
+}
+
+esp_err_t muse_speech_prewarm(esp_http_client_handle_t client, const char *url)
+{
+    char health[192];
+    const char *host = strstr(url, "://");
+    const char *path = host ? strchr(host + 3, '/') : NULL;
+    int base = path ? (int)(path - url) : (int)strlen(url);
+    snprintf(health, sizeof(health), "%.*s/health", base, url);
+    int64_t t0 = esp_timer_get_time();
+    esp_http_client_set_url(client, health);
+    esp_http_client_set_method(client, HTTP_METHOD_GET);
+    esp_http_client_set_post_field(client, NULL, 0);
+    esp_err_t err = esp_http_client_perform(client);
+    int status = esp_http_client_get_status_code(client);
+    ESP_LOGI(TAG, "connection to %.*s ready in %d ms (HTTP %d%s)", base, url,
+             (int)((esp_timer_get_time() - t0) / 1000), status, err == ESP_OK ? "" : ", failed");
+    return err != ESP_OK ? err : status == 200 ? ESP_OK : ESP_FAIL;
+}
