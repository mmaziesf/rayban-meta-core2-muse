+++ b/esp32/devices/sdkconfig.muse-m5stack-core2-v11
@@ -50,3 +50,7 @@ CONFIG_BTDM_CTRL_MODE_BTDM=n
 # CONFIG_BSP_PMU_AXP192 is not set
 CONFIG_BSP_PMU_AXP2101=y
 
+# glasses.capture: Muse can ask for the latest Ray-Ban Meta frame from the
