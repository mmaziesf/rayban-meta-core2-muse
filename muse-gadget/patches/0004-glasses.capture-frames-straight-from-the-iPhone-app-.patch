 esp32/main/Kconfig.projbuild |  14 +-
 esp32/main/app.c             |   3 +
 esp32/main/glasses_capture.c | 267 ++++++++++++++++++++++++++++++++++-
 esp32/main/glasses_capture.h |  20 ++-
 esp32/main/idf_component.yml |   4 +
 6 files changed, 305 insertions(+), 10 deletions(-)

