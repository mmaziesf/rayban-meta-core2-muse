+#endif  // TENSORFLOW_LITE_EXPERIMENTAL_MICROFRONTEND_LIB_WINDOW_H_
diff --git a/esp32/components/microfrontend/tensorflow/lite/experimental/microfrontend/lib/window_util.c b/esp32/components/microfrontend/tensorflow/lite/experimental/microfrontend/lib/window_util.c
new file mode 100644
index 0000000..6fdffdc
--- /dev/null
+++ b/esp32/components/microfrontend/tensorflow/lite/experimental/microfrontend/lib/window_util.c
@@ -0,0 +1,73 @@
