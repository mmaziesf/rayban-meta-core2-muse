+ * limitations under the License.
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Speech-to-text on a server of your own (CONFIG_MUSE_STT_URL): the push-to-
+ * talk recording is POSTed as raw 16-bit mono PCM (?rate=<hz>) and the server
+ * answers with the transcript as text/plain. Runs on its own task over a kept
+ * connection (muse_speech_http.h); the PCM must stay valid until the fetch
+ * has finished (muse_stt_fetch_busy() false), even after a cancel.
+ */
+bool muse_stt_fetch_start(const int16_t *pcm, size_t samples, int rate);
+
+/* 0 while the request runs, 1 with a transcript, -1 if it failed. */
+int muse_stt_fetch_state(void);
+
+/* The transcript once the state is 1 (may be empty: nothing was heard). */
+const char *muse_stt_fetch_text(void);
+
+void muse_stt_fetch_cancel(void);
+
+/* True while a request (even a cancelled one) is still running. */
+bool muse_stt_fetch_busy(void);
+
+/* Opens the connection to the server now (at the start of a turn), so the
+ * transcription request doesn't pay for it; no-op while a request runs. */
+void muse_stt_fetch_prewarm(void);
+
+/* Closes the connection and frees its buffers (at the end of a turn). */
+void muse_stt_fetch_release(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/esp32/components/muse/muse_tts_fetch.c b/esp32/components/muse/muse_tts_fetch.c
new file mode 100644
index 0000000..fb2d3f5
--- /dev/null
+++ b/esp32/components/muse/muse_tts_fetch.c
@@ -0,0 +1,236 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "muse_tts_fetch.h"
+
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "esp_heap_caps.h"
+#include "esp_http_client.h"
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/idf_additions.h"
+#include "freertos/stream_buffer.h"
+#include "freertos/task.h"
+#include "muse_speech_http.h"
+#include "sdkconfig.h"
+
+#if CONFIG_MUSE_TTS
+
+static const char *TAG = "muse_tts";
+
+#define BUF_BYTES (48 * 1024)   /* MP3 in flight between the fetch task and the session task */
+
+static StreamBufferHandle_t s_buf;
+static atomic_int s_state;       /* 0 running, 1 done, -1 failed */
+static atomic_uint s_gen;        /* bumped by start/cancel; a fetch stops once it's stale */
+static atomic_bool s_running;    /* a fetch task exists */
+
+/* One connection, kept between sentences; only the running task uses it. */
+static esp_http_client_handle_t s_client;
+static unsigned s_job_gen;       /* the running fetch's generation, for the handler */
+static bool s_dropped;           /* it went stale and its connection was closed */
+static bool s_warming;           /* a prewarm's GET /health: its body isn't speech */
+
+typedef struct {
+    unsigned gen;
+    char text[];                 /* empty: just open the connection */
+} job_t;
+
+static esp_err_t on_event(esp_http_client_event_t *e)
+{
+    if (e->event_id != HTTP_EVENT_ON_DATA || e->data_len <= 0 || s_dropped || s_warming) {
+        return ESP_OK;
+    }
+    if (esp_http_client_get_status_code(e->client) != 200) {
+        return ESP_OK;
+    }
+    const uint8_t *p = e->data;
+    size_t n = e->data_len, sent = 0;
+    while (sent < n && atomic_load(&s_gen) == s_job_gen) {
+        sent += xStreamBufferSend(s_buf, p + sent, n - sent, pdMS_TO_TICKS(100));
+    }
+    if (atomic_load(&s_gen) != s_job_gen) {
+        /* Cancelled mid-reply: stop reading it now rather than draining the
+         * rest of the sentence; the next fetch opens a fresh connection. */
+        s_dropped = true;
+        esp_http_client_close(e->client);
+    }
+    return ESP_OK;
+}
+
+static void drop_client(void)
+{
+    if (s_client) {
+        esp_http_client_cleanup(s_client);
+        s_client = NULL;
+    }
+}
+
+/* One request on the kept connection, or on a new one if that had gone stale. */
+static esp_err_t request(const job_t *job, size_t len)
+{
+    esp_err_t err = ESP_FAIL;
+    s_dropped = false;
+    for (int attempt = 0; attempt < 2; attempt++) {
+        if (!s_client) {
+            s_client = muse_speech_client(CONFIG_MUSE_TTS_URL, 15000, on_event);
+        }
+        if (!s_client) {
+            return ESP_ERR_NO_MEM;
+        }
+        if (!len) {
+            s_warming = true;
+            err = muse_speech_prewarm(s_client, CONFIG_MUSE_TTS_URL);
+            s_warming = false;
+        } else {
+            s_job_gen = job->gen;
+            s_dropped = false;
+            esp_http_client_set_url(s_client, CONFIG_MUSE_TTS_URL);
+            esp_http_client_set_method(s_client, HTTP_METHOD_POST);
+            esp_http_client_set_header(s_client, "Content-Type", "text/plain; charset=utf-8");
+            esp_http_client_set_post_field(s_client, job->text, (int)len);
+            err = esp_http_client_perform(s_client);
+            esp_http_client_set_post_field(s_client, NULL, 0);
+        }
+        if (err == ESP_OK || s_dropped || attempt || !muse_speech_stale(err)) {
+            break;
+        }
+        drop_client();
+    }
+    if (s_dropped || (err != ESP_OK && err != ESP_FAIL)) {
+        drop_client();   /* closed mid-reply, or in an unknown state: never reuse it */
+    }
+    return err;
+}
+
+static void fetch_task(void *arg)
+{
+    job_t *job = arg;
+    size_t len = strlen(job->text);
+    esp_err_t err = request(job, len);
+    int result = -1;
+    if (len && !s_dropped) {
+        int status = s_client ? esp_http_client_get_status_code(s_client) : 0;
+        if (err == ESP_OK && status == 200) {
+            result = 1;
+        } else if (err == ESP_OK) {
+            ESP_LOGW(TAG, "speech server answered HTTP %d", status);
+        } else {
+            ESP_LOGW(TAG, "speech server unreachable (%s): %s", esp_err_to_name(err), CONFIG_MUSE_TTS_URL);
+        }
+    }
+    if (len && atomic_load(&s_gen) == job->gen) {
+        atomic_store(&s_state, result);
+    }
+    free(job);
+    atomic_store(&s_running, false);
+    vTaskDeleteWithCaps(NULL);
+}
+
+static void wait_idle(void)
+{
+    for (int i = 0; i < 100 && atomic_load(&s_running); i++) {
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+}
+
+bool muse_tts_fetch_start(const char *text)
+{
+    if (!text || !text[0]) {
+        return false;
+    }
+    if (!s_buf) {
+        s_buf = xStreamBufferCreateWithCaps(BUF_BYTES, 1, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+        if (!s_buf) {
+            return false;
+        }
+    }
+    unsigned gen = atomic_fetch_add(&s_gen, 1) + 1;
+    wait_idle();   /* a stale fetch drops its connection at its next data and exits */
+    if (atomic_load(&s_running)) {
+        ESP_LOGW(TAG, "previous fetch still running");
+        return false;
+    }
+    xStreamBufferReset(s_buf);
+    size_t len = strlen(text);
+    job_t *job = malloc(sizeof(job_t) + len + 1);
+    if (!job) {
+        return false;
+    }
+    job->gen = gen;
+    memcpy(job->text, text, len + 1);
+    atomic_store(&s_state, 0);
+    atomic_store(&s_running, true);
+    if (xTaskCreateWithCaps(fetch_task, "muse_tts", 6144, job, 4, NULL,
+                            MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+        atomic_store(&s_running, false);
+        free(job);
+        return false;
+    }
+    return true;
+}
+
+void muse_tts_fetch_prewarm(void)
+{
+    if (atomic_load(&s_running)) {
+        return;
+    }
+    job_t *job = calloc(1, sizeof(job_t) + 1);
+    if (!job) {
+        return;
+    }
+    job->gen = atomic_load(&s_gen);
+    atomic_store(&s_running, true);
+    if (xTaskCreateWithCaps(fetch_task, "muse_tts", 6144, job, 4, NULL,
+                            MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+        atomic_store(&s_running, false);
+        free(job);
+    }
+}
+
+void muse_tts_fetch_release(void)
+{
+    if (atomic_exchange(&s_running, true)) {
+        return;   /* a fetch is using it; the next release frees it */
+    }
+    drop_client();
+    atomic_store(&s_running, false);
+}
+
+size_t muse_tts_fetch_read(void *buf, size_t cap)
+{
+    return s_buf ? xStreamBufferReceive(s_buf, buf, cap, 0) : 0;
+}
+
+size_t muse_tts_fetch_available(void)
+{
+    return s_buf ? xStreamBufferBytesAvailable(s_buf) : 0;
+}
+
+int muse_tts_fetch_state(void)
+{
+    return atomic_load(&s_state);
+}
+
+void muse_tts_fetch_cancel(void)
+{
+    atomic_fetch_add(&s_gen, 1);
+    atomic_store(&s_state, -1);
+}
+
+#endif /* CONFIG_MUSE_TTS */
diff --git a/esp32/components/muse/muse_tts_fetch.h b/esp32/components/muse/muse_tts_fetch.h
new file mode 100644
index 0000000..f8c9843
--- /dev/null
+++ b/esp32/components/muse/muse_tts_fetch.h
@@ -0,0 +1,59 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Spoken replies from a text-to-speech server of your own
+ * (CONFIG_MUSE_TTS_URL): the reply text is POSTed as text/plain and the
+ * server streams back MP3 over a kept connection (muse_speech_http.h). The
+ * HTTP request runs on its own task so the Muse session task never blocks on
+ * it; the session task drains the audio with muse_tts_fetch_read() into its
+ * MP3 decoder.
+ */
+
+/* Starts fetching speech for `text`, cancelling any fetch in progress. */
+bool muse_tts_fetch_start(const char *text);
+
+/* Copies up to `cap` bytes of MP3 that have arrived; never blocks. */
+size_t muse_tts_fetch_read(void *buf, size_t cap);
+
+/* 0 while the fetch runs, 1 once all the MP3 has arrived, -1 if it failed.
+ * Bytes may still be waiting in the buffer in either final state. */
+int muse_tts_fetch_state(void);
+
+/* Bytes waiting to be read. */
+size_t muse_tts_fetch_available(void);
+
+/* Abandons the current fetch (turn cancelled or reset). */
+void muse_tts_fetch_cancel(void);
+
+/* Opens the connection to the server now (at the start of a turn), so the
+ * first reply doesn't pay for it; no-op while a fetch runs. */
+void muse_tts_fetch_prewarm(void);
+
+/* Closes the connection and frees its buffers (at the end of a turn). */
+void muse_tts_fetch_release(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/esp32/components/muse/muse_voice.c b/esp32/components/muse/muse_voice.c
index 35a7ff4..192a46c 100644
--- a/esp32/components/muse/muse_voice.c
+++ b/esp32/components/muse/muse_voice.c
@@ -37,6 +37,11 @@
 #include "muse_settings.h"
 #include "muse_state.h"
 #include "muse_wifi.h"
+#if CONFIG_MUSE_WAKE_WORD
+#include "muse_stt_fetch.h"
+#include "muse_tts_fetch.h"
+#include "muse_wake.h"
+#endif
 
 static const char *TAG = "muse_voice";
 
@@ -94,6 +99,37 @@ static size_t s_pre_next, s_pre_fill;
 static muse_adpcm_t s_pre_enc;
 #endif
 static int16_t s_chunk[MUSE_AUDIO_CHUNK];
+
+#if CONFIG_MUSE_HANDS_FREE
+/* Hands-free: speech is judged against the room's background level. */
