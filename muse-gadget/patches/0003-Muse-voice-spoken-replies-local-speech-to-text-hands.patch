+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#pragma once
+
+#include <stdbool.h>
+
+#include "esp_http_client.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * The speech server connections (muse_tts_fetch, muse_stt_fetch): kept open
+ * for the length of a voice turn, so the turn's requests (the transcript,
+ * each sentence of the reply) reuse one TCP (and TLS) connection, and opened
+ * as the turn starts. They're freed when the turn ends: their buffers sit in
+ * internal RAM, which the display's DMA transfers need.
+ * https:// URLs are checked against the built-in CA bundle, and
+ * CONFIG_MUSE_SPEECH_TOKEN, when set, goes in each request as a bearer token.
+ */
+
+/* A client for url that keeps its connection; handler gets the response data. */
+esp_http_client_handle_t muse_speech_client(const char *url, int timeout_ms, http_event_handle_cb handler);
+
+/* True if err means the kept connection failed before any response (the
+ * server closed it): retry the request on a new client. */
+bool muse_speech_stale(esp_err_t err);
+
+/* Opens (or checks) the connection ahead of a request: GET /health on url's server. */
+esp_err_t muse_speech_prewarm(esp_http_client_handle_t client, const char *url);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/esp32/components/muse/muse_stt_fetch.c b/esp32/components/muse/muse_stt_fetch.c
new file mode 100644
index 0000000..34b5c0f
--- /dev/null
+++ b/esp32/components/muse/muse_stt_fetch.c
@@ -0,0 +1,208 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "muse_stt_fetch.h"
+
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "esp_heap_caps.h"
+#include "esp_http_client.h"
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/idf_additions.h"
+#include "freertos/task.h"
+#include "muse_speech_http.h"
+#include "sdkconfig.h"
+
+#if CONFIG_MUSE_LOCAL_STT
+
+static const char *TAG = "muse_stt";
+
+#define TEXT_MAX 1024
+
+static char s_text[TEXT_MAX];
+static atomic_int s_state = -1;
+static atomic_uint s_gen;
+static atomic_bool s_running;
+
+/* One connection, kept between requests; only the running task uses it. */
+static esp_http_client_handle_t s_client;
+static char s_got[TEXT_MAX];
+static int s_got_len;
+
+typedef struct {
+    unsigned gen;
+    const int16_t *pcm;   /* NULL: just open the connection */
+    size_t samples;
+    int rate;
+} job_t;
+
+static esp_err_t on_event(esp_http_client_event_t *e)
+{
+    if (e->event_id == HTTP_EVENT_ON_DATA && e->data_len > 0) {
+        int n = e->data_len < TEXT_MAX - 1 - s_got_len ? e->data_len : TEXT_MAX - 1 - s_got_len;
+        memcpy(s_got + s_got_len, e->data, n);
+        s_got_len += n;
+    }
+    return ESP_OK;
+}
+
+static void drop_client(void)
+{
+    if (s_client) {
+        esp_http_client_cleanup(s_client);
+        s_client = NULL;
+    }
+}
+
+/* One request on the kept connection, or on a new one if that had gone stale. */
+static esp_err_t request(const job_t *job)
+{
+    esp_err_t err = ESP_FAIL;
+    for (int attempt = 0; attempt < 2; attempt++) {
+        if (!s_client) {
+            s_client = muse_speech_client(CONFIG_MUSE_STT_URL, 8000, on_event);
+        }
+        if (!s_client) {
+            return ESP_ERR_NO_MEM;
+        }
+        if (!job->pcm) {
+            err = muse_speech_prewarm(s_client, CONFIG_MUSE_STT_URL);
+        } else {
+            char url[sizeof(CONFIG_MUSE_STT_URL) + 24];
+            snprintf(url, sizeof(url), "%s?rate=%d", CONFIG_MUSE_STT_URL, job->rate);
+            esp_http_client_set_url(s_client, url);
+            esp_http_client_set_method(s_client, HTTP_METHOD_POST);
+            esp_http_client_set_header(s_client, "Content-Type", "application/octet-stream");
+            esp_http_client_set_post_field(s_client, (const char *)job->pcm, (int)(job->samples * sizeof(int16_t)));
+            s_got_len = 0;
+            err = esp_http_client_perform(s_client);
+            esp_http_client_set_post_field(s_client, NULL, 0);
+        }
+        if (err == ESP_OK || attempt || !muse_speech_stale(err)) {
+            break;
+        }
+        drop_client();
+    }
+    if (err != ESP_OK && err != ESP_FAIL) {
+        drop_client();   /* never reuse a connection in an unknown state */
+    }
+    return err;
+}
+
+static void stt_task(void *arg)
+{
+    job_t job = *(job_t *)arg;
+    free(arg);
+    esp_err_t err = request(&job);
+    int result = -1;
+    if (job.pcm) {
+        int status = s_client ? esp_http_client_get_status_code(s_client) : 0;
+        if (err == ESP_OK && status == 200) {
+            s_got[s_got_len] = '\0';
+            result = 1;
+        } else if (err == ESP_OK) {
+            ESP_LOGW(TAG, "speech server answered HTTP %d", status);
+        } else {
+            ESP_LOGW(TAG, "speech server unreachable (%s): %s", esp_err_to_name(err), CONFIG_MUSE_STT_URL);
+        }
+    }
+    if (job.pcm && atomic_load(&s_gen) == job.gen) {
+        strlcpy(s_text, result > 0 ? s_got : "", sizeof(s_text));
+        atomic_store(&s_state, result);
+    }
+    atomic_store(&s_running, false);
+    vTaskDeleteWithCaps(NULL);
+}
+
+static bool spawn(job_t *job)
+{
+    atomic_store(&s_running, true);
+    if (xTaskCreateWithCaps(stt_task, "muse_stt", 6144, job, 5, NULL, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+        atomic_store(&s_running, false);
+        free(job);
+        return false;
+    }
+    return true;
+}
+
+void muse_stt_fetch_prewarm(void)
+{
+    if (atomic_load(&s_running)) {
+        return;
+    }
+    job_t *job = calloc(1, sizeof(*job));
+    if (job) {
+        spawn(job);
+    }
+}
+
+bool muse_stt_fetch_start(const int16_t *pcm, size_t samples, int rate)
+{
+    unsigned gen = atomic_fetch_add(&s_gen, 1) + 1;
+    for (int i = 0; i < 100 && atomic_load(&s_running); i++) {
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+    if (atomic_load(&s_running)) {
+        return false;
+    }
+    job_t *job = malloc(sizeof(*job));
+    if (!job) {
+        return false;
+    }
+    *job = (job_t){ gen, pcm, samples, rate };
+    s_text[0] = '\0';
+    atomic_store(&s_state, 0);
+    if (!spawn(job)) {
+        atomic_store(&s_state, -1);
+        return false;
+    }
+    return true;
+}
+
+int muse_stt_fetch_state(void)
+{
+    return atomic_load(&s_state);
+}
+
+const char *muse_stt_fetch_text(void)
+{
+    return s_text;
+}
+
+void muse_stt_fetch_cancel(void)
+{
+    atomic_fetch_add(&s_gen, 1);
+    atomic_store(&s_state, -1);
+}
+
+bool muse_stt_fetch_busy(void)
+{
+    return atomic_load(&s_running);
+}
+
+void muse_stt_fetch_release(void)
+{
+    if (atomic_exchange(&s_running, true)) {
+        return;   /* a request is using it; the next release frees it */
+    }
+    drop_client();
+    atomic_store(&s_running, false);
+}
+
+#endif /* CONFIG_MUSE_LOCAL_STT */
