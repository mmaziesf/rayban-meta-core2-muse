+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * On-device wake word (CONFIG_MUSE_WAKE_WORD): a microWakeWord streaming model
+ * (embedded .tflite, e.g. "Hey Jarvis") run with TensorFlow Lite Micro on the
+ * TFLM audio microfrontend's 40-channel log-mel features (30 ms windows every
+ * 10 ms), the same features the models are trained on.
+ */
+
+/* Loads the model; false if it can't run (no memory, bad model). */
+bool muse_wake_init(void);
+
+/* Feeds 16 kHz mono PCM. True when the wake word was just heard. */
+bool muse_wake_feed(const int16_t *pcm, size_t samples);
+
+/* Forgets recent audio (after a turn, so the reply doesn't count). */
+void muse_wake_reset(void);
+
+#ifdef __cplusplus
+}
+#endif
