+/*
+ * Fetches the latest Ray-Ban Meta glasses frame from a relay on the home
+ * network (CONFIG_HOMEHUB_GLASSES_CAPTURE_URL, an HTTP GET returning one JPEG)
+ * for the glasses.capture command. On success *jpeg_base64 is a heap string
+ * the caller frees; on failure *error is a static message.
+ */
+bool glasses_capture(char **jpeg_base64, const char **error);
