<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged by xtool over its generated defaults (bundle ID, executable, versions).
  xtool does not expand $(VARIABLES), so every value here is literal.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Glasses Bridge</string>

	<!-- Meta AI calls back into the app through this scheme after registration/permission flows. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.example.glassesbridge</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>glassesbridge</string>
			</array>
		</dict>
	</array>

	<!-- Meta Wearables Device Access Toolkit. MetaAppID "0" = Developer Mode (no attestation). -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>glassesbridge://</string>
		<key>MetaAppID</key>
		<string>0</string>
		<key>ClientToken</key>
		<string></string>
		<key>TeamID</key>
		<string></string>
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>

	<!-- Transports DAT uses: BLE, Bluetooth Classic (camera streaming), Wi-Fi (high bandwidth). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Needed to connect to Meta AI Glasses</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Needed to connect to Meta AI Glasses</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connects to your glasses over Wi-Fi and sends their camera frames to your computer on the local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>

	<!-- Plain ws:// to a LAN address. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
