diff --git a/esp32/components/microfrontend/CMakeLists.txt b/esp32/components/microfrontend/CMakeLists.txt
new file mode 100644
index 0000000..7ea0547
--- /dev/null
+++ b/esp32/components/microfrontend/CMakeLists.txt
@@ -0,0 +1,22 @@
+# TensorFlow Lite Micro's audio "microfrontend" (Apache-2.0, from
+# github.com/tensorflow/tflite-micro tensorflow/lite/experimental/microfrontend/lib),
+# the log-mel feature generator microWakeWord models are trained on. esp-tflite-micro
+# 1.4.x no longer ships it. Built only with CONFIG_MUSE_WAKE_WORD.
+if(NOT CONFIG_MUSE_WAKE_WORD)
+    idf_component_register()
+    return()
+endif()
+
+set(lib tensorflow/lite/experimental/microfrontend/lib)
+idf_component_register(
+    SRCS ${lib}/fft.cc ${lib}/fft_util.cc ${lib}/filterbank.c ${lib}/filterbank_util.c
+         ${lib}/frontend.c ${lib}/frontend_util.c ${lib}/kiss_fft_int16.cc ${lib}/log_lut.c
+         ${lib}/log_scale.c ${lib}/log_scale_util.c ${lib}/noise_reduction.c
+         ${lib}/noise_reduction_util.c ${lib}/pcan_gain_control.c ${lib}/pcan_gain_control_util.c
+         ${lib}/window.c ${lib}/window_util.c
+    INCLUDE_DIRS ".")
+
+# kissfft (FIXED_POINT 16, in its own namespace) comes from esp-tflite-micro's third_party.
+idf_component_get_property(tflm_dir espressif__esp-tflite-micro COMPONENT_DIR)
+target_include_directories(${COMPONENT_LIB} PRIVATE "${tflm_dir}/third_party/kissfft")
+target_compile_options(${COMPONENT_LIB} PRIVATE -Wno-unused-variable -Wno-maybe-uninitialized)
diff --git a/esp32/components/microfrontend/README.md b/esp32/components/microfrontend/README.md
new file mode 100644
index 0000000..1e930e3
--- /dev/null
+++ b/esp32/components/microfrontend/README.md
@@ -0,0 +1,7 @@
+# microfrontend
+
+TensorFlow Lite Micro's audio feature frontend (`tensorflow/lite/experimental/microfrontend/lib`),
+copied unchanged from [tensorflow/tflite-micro](https://github.com/tensorflow/tflite-micro)
+under the Apache License 2.0 (see each file's header). It turns 16 kHz audio into the
+40-channel log-mel features that microWakeWord models expect. Used by `muse_wake.cc`
+when `CONFIG_MUSE_WAKE_WORD` is enabled.
