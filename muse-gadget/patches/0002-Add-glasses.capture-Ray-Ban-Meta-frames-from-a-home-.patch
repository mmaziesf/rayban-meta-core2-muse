 esp32/main/CMakeLists.txt                     |   1 +
 esp32/main/Kconfig.projbuild                  |  20 +++
 esp32/main/app.c                              |  51 ++++++++
 esp32/main/glasses_capture.c                  | 122 ++++++++++++++++++
 esp32/main/glasses_capture.h                  |  26 ++++
 esp32/main/noise_control.cpp                  |  12 ++
 7 files changed, 236 insertions(+)
