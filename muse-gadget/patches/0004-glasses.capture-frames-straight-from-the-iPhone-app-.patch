index 0b05bd7..649de10 100644
--- a/esp32/main/glasses_capture.h
+++ b/esp32/main/glasses_capture.h
@@ -18,9 +18,21 @@
 #include <stdbool.h>
 
 /*
- * Fetches the latest Ray-Ban Meta glasses frame from a relay on the home
- * network (CONFIG_HOMEHUB_GLASSES_CAPTURE_URL, an HTTP GET returning one JPEG)
- * for the glasses.capture command. On success *jpeg_base64 is a heap string
- * the caller frees; on failure *error is a static message.
+ * Fetches the latest Ray-Ban Meta glasses frame for the glasses.capture
+ * command: from the Glasses Bridge iPhone app found over mDNS
+ * (CONFIG_HOMEHUB_GLASSES_DISCOVER), else from a relay on the home network
+ * (CONFIG_HOMEHUB_GLASSES_CAPTURE_URL); either is an HTTP GET returning one
+ * JPEG. On success *jpeg_base64 is a heap string the caller frees; on failure
+ * *error is a static message.
  */
 bool glasses_capture(char **jpeg_base64, const char **error);
+
+/*
+ * Pre-arms capture: finds the phone as soon as Wi-Fi is up and, at the start
+ * of each voice turn, fetches a frame in the background for the
+ * glasses.capture that's likely to follow. Call once at boot.
+ */
+void glasses_capture_start(void);
+
+/* Starts a background fetch now (called at each turn's start). */
+void glasses_capture_prefetch(void);
