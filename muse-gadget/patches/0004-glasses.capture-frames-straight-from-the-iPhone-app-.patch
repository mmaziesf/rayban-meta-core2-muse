+    idf_component_get_property(mdns_lib espressif__mdns COMPONENT_LIB)
+    target_link_libraries(${COMPONENT_LIB} PRIVATE ${mdns_lib})
+endif()
diff --git a/esp32/main/Kconfig.projbuild b/esp32/main/Kconfig.projbuild
index 837a298..34c4e74 100644
--- a/esp32/main/Kconfig.projbuild
+++ b/esp32/main/Kconfig.projbuild
@@ -333,7 +333,19 @@ menu "ESP32 Device SDK"
             HTTP URL that returns the latest glasses frame as one JPEG, or
             503 while the glasses are not streaming. Set it per device to the
             relay computer's address (idf.py menuconfig, or the build
-            directory's sdkconfig), as with the SDK token.
+            directory's sdkconfig), as with the SDK token. With
+            HOMEHUB_GLASSES_DISCOVER it is the fallback for when no phone is
+            found; leave it empty to use the phone only.
+
+    config HOMEHUB_GLASSES_DISCOVER
